namespace {{ Name }}.Api;

/// <summary>
/// Serves the published Angular app from wwwroot. Any path that is not a file and not under /api returns the app's
/// index page so client-side routes work on reload; unknown /api paths still return 404.
/// </summary>
public static class SpaStartup
{
    public const string IndexFile = "{{ IndexFile }}";

    /// <summary>
    /// <c>nonfile</c> keeps requests for files such as main.js away from the fallback, so the static file middleware
    /// serves them; the regex keeps unknown API paths returning 404.
    /// </summary>
    public static void MapFallback(WebApplication app) =>
        app.MapFallbackToFile("{*path:nonfile:regex(^(?!api(/|$)).*$)}", IndexFile).AllowAnonymous();
}
