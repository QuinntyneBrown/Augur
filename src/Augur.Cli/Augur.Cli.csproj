<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Augur.Cli</RootNamespace>
    <AssemblyName>augur</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>augur</ToolCommandName>
    <PackageId>Augur.Cli</PackageId>
    <Description>Augur: a .NET and Angular code generator that uses the OpenAI Decisions API to decide what to generate, then emits code deterministically.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Augur.Tests" />
    <InternalsVisibleTo Include="Augur.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Augur.Core/Augur.Core.csproj" />
    <ProjectReference Include="../Augur.Emission/Augur.Emission.csproj" />
    <ProjectReference Include="../Augur.Emission.Angular/Augur.Emission.Angular.csproj" />
    <ProjectReference Include="../Augur.Emission.DotNet/Augur.Emission.DotNet.csproj" />
    <ProjectReference Include="../Augur.Oracle.OpenAI/Augur.Oracle.OpenAI.csproj" />
    <ProjectReference Include="../Augur.Oracle.Scripted/Augur.Oracle.Scripted.csproj" />
  </ItemGroup>
</Project>
