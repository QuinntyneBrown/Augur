import { Component, afterNextRender, inject, signal } from '@angular/core';
import { HealthApi, HealthStatus } from '../../core/health-api';

@Component({
  selector: 'app-home',
  template: `
    <h1 tabindex="-1">{{ Title }}</h1>
    <p>Welcome. This app was generated by Augur. Replace this page with your own.</p>
    <p role="status">{%{API: {{ status() }}}%}</p>
  `,
})
export class Home {
  protected readonly status = signal<HealthStatus | 'Checking'>('Checking');
  private readonly health = inject(HealthApi);

  constructor() {
    afterNextRender(() => this.health.check().subscribe((status) => this.status.set(status)));
  }
}
