@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Evaluate the decision tree

Person(dev, "Developer", "Runs augur plan against a specification")
System(augur, "Augur CLI", "Decides what to generate, then emits code")
