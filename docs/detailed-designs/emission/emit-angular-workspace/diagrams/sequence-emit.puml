@startuml
title UML sequence behaviour — Emit an Angular workspace
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend — augur CLI (Augur.Cli)" #E0F2FE
  participant "EmitCommand" as cmd
end box
box "Backend — Augur Core (Augur.Core)" #ECFDF3
  participant "PlanValidator" as validator
  participant "AngularProjectName" as naming
end box
box "Backend — Augur Infrastructure (Emission)" #FFF4E5
  participant "EmissionPipeline" as pipeline
  participant "AngularWorkspaceEmitter" as emitter
  participant "AngularTemplateGroupSelector" as selector
  participant "TemplateEngine" as engine
  participant "FileSet" as files
end box

dev -> cmd : augur emit --plan plan.json --out ./out
cmd -> validator : Validate(plan)
validator --> cmd : valid GenerationPlan
cmd -> pipeline : Run(EmissionContext)
pipeline -> emitter : Emit(context)
emitter -> naming : From("Acme.HRPortal") (L2-051)
naming --> emitter : "acme-hr-portal"
emitter -> emitter : WorkspaceRoot = target == fullstack ? "web/" : "."
emitter -> selector : Select(plan) (L2-052)
selector --> emitter : [Common, ShellMaterial, StateSignals, AuthOidcPkce]
emitter -> emitter : Build WorkspaceModel with exact versions from NpmPackageCatalog (L2-054)
emitter -> engine : Render("Common/angular.json", model with BudgetModel) (L2-057)
engine --> emitter : angular.json
emitter -> files : Add("{root}/angular.json", text)
emitter -> engine : Render("Common/package.json", model)
engine --> emitter : package.json (exact versions)
emitter -> files : Add("{root}/package.json", text)
emitter -> engine : Static("Common/package-lock.json")
engine --> emitter : bytes
emitter -> files : AddBinary("{root}/package-lock.json", bytes)
loop for each selected group
  loop for each template in group
    emitter -> engine : Render(template, model)
    engine --> emitter : text
    emitter -> files : Add("{root}/src/...", text)
  end
end
emitter --> pipeline : FileSet (no npm / ng / node started)
pipeline --> cmd : files written to ./out
cmd --> dev : exit 0; summary on stderr
@enduml
