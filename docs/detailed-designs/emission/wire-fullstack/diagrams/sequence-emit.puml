@startuml
title UML sequence behaviour — Emit the fullstack output
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
box "Frontend — augur CLI (Augur.Cli)" #E0F2FE
  participant "EmitCommand" as cmd
end box
box "Backend — Augur Core (Augur.Core)" #ECFDF3
  participant "PlanValidator" as validator
end box
box "Backend — Augur Infrastructure (Emission)" #FFF4E5
  participant "EmissionPipeline" as pipeline
  participant "FullstackEmitter" as emitter
  participant "DotNetSolutionEmitter" as dotnet
  participant "AngularWorkspaceEmitter" as angular
  participant "TemplateEngine" as engine
  participant "FileSet" as files
end box

dev -> cmd : augur emit --plan plan.json --out ./out
cmd -> validator : Validate(plan) — target = fullstack
validator --> cmd : valid GenerationPlan
cmd -> pipeline : Run(EmissionContext)
pipeline -> emitter : Emit(context)
emitter -> dotnet : Emit(context, root = ".") (L2-053)
dotnet --> emitter : FileSet A ({Name}.slnx, projects, tests)
emitter -> angular : Emit(context, root = "web/") (L2-053)
angular --> emitter : FileSet B (web/angular.json, web/package.json, web/src/...)
emitter -> files : Merge(A, B) — throws on path collision
emitter -> engine : Render("Fullstack/proxy.conf.json", model)
engine --> emitter : text
emitter -> files : Add("web/proxy.conf.json")
emitter -> engine : Render("Fullstack/environment.ts", model) — apiBaseUrl '/api'
emitter -> files : Add("web/src/environments/environment.ts")
emitter -> engine : Render("Fullstack/HealthApi.ts"), Render("Fullstack/HomeComponent.*")
emitter -> files : Add(...)
emitter -> engine : Render("Fullstack/HealthEndpoint.cs"), Render("Fullstack/SpaStartup.cs")
emitter -> files : Add("{Name}.Api/...")
emitter -> engine : Render("Fullstack/Api.csproj", model) — BuildAngular publish target
emitter -> files : Add("{Name}.Api/{Name}.Api.csproj") (replaces inner csproj)
emitter --> pipeline : merged FileSet (no child process started)
pipeline --> cmd : ./out/{Name}.slnx and ./out/web/angular.json written
cmd --> dev : exit 0
@enduml
