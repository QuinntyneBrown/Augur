@startuml
title UML sequence behaviour — Install, run, uninstall
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer" as dev
participant ".NET SDK (dotnet)" as sdk
participant "NuGet feed" as feed
box "Frontend — augur CLI (Augur.Cli)" #E0F2FE
  participant "Program" as prog
  participant "VersionInfo" as version
end box
box "Backend — Augur Core (Augur.Core)" #ECFDF3
  participant "DecisionCatalog" as catalog
end box

dev -> sdk : dotnet tool install --global Augur.Cli --add-source <feed> (L2-049)
sdk -> feed : fetch Augur.Cli
feed --> sdk : .nupkg (PackAsTool, net10.0)
sdk -> sdk : extract; create augur shim on PATH
sdk --> dev : installed
dev -> prog : augur --version
prog -> version : Render()
version -> catalog : CatalogVersion
catalog --> version : 2
version --> prog : "augur 1.2.3 (catalog 2)"
prog --> dev : stdout line; exit 0 (L2-049)
dev -> sdk : dotnet tool uninstall --global Augur.Cli
sdk -> sdk : remove shim and package
sdk --> dev : uninstalled; augur no longer resolves (L2-049)
@enduml
