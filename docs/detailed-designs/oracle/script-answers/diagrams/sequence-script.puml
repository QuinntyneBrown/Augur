@startuml
title UML sequence behaviour — Answer from a script
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Developer or CI job" as dev
box "Frontend — augur CLI (Augur.Cli)" #E0F2FE
  participant "PlanCommand" as cmd
end box
box "Backend — Augur Core (Augur.Core)" #ECFDF3
  participant "TreeEvaluator" as eval
  participant "DecisionResolver" as res
  participant "LockfileStore" as lock
end box
box "Backend — Augur Infrastructure (Oracle / file system)" #FFF4E5
  participant "ScriptedOracle" as oracle
  participant "AnswerScriptReader" as reader
  database "answers.json" as file
end box

dev -> cmd : augur plan --spec spec.md --oracle-script answers.json
cmd -> oracle : construct(path)
oracle -> reader : Read(path)
reader -> file : read bytes
alt invalid JSON
  reader --> oracle : UsageException(path, line, position)
  oracle --> cmd : propagates
  cmd --> dev : error: ... (exit 2)
else parsed
  reader --> oracle : AnswerScript
end
cmd -> eval : EvaluateAsync(input, overrides)
eval -> oracle : AnswerAsync(input, pending requests) (L2-038)
loop for each request
  alt no entry for decision id
    oracle -> oracle : collect missing id
  else entry present
    oracle -> oracle : ScriptedAnswerMapper.Map(raw, definition) -> Source = Script
  end
end
alt any id missing
  oracle --> eval : MissingScriptedAnswerException(ids)
  eval --> cmd : propagates
  cmd --> dev : error: no scripted answer for ... (exit 3)
else all present
  oracle --> eval : DecisionAnswer per request
  loop for each answer
    eval -> res : Resolve(definition, answer) — same thresholds and closed-answer checks (L2-038)
    res --> eval : Resolved or LowConfidence
  end
  eval --> cmd : DecisionState
  cmd -> lock : Write entries with source = script (L2-038)
  cmd --> dev : plan on stdout; no network request was made
end
@enduml
